app/coverage.out

# Editor and OS files
.DS_Store
Thumbs.db
*.swp
*.swo
.vscode/
.idea/

# Helm working files
helm/**/*.lock

# Log archives
ssb-logs/

# Docker build context leftovers
*.tar.gz
