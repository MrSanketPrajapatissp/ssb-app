# Environment Variables — ssb-app Platform
# Copy this file to .env and populate with real values.
# NEVER commit the .env file to Git.

# ── Container Registry ───────────────────────────────────────
# For kind local demo:
REGISTRY=localhost:5001
# For production (AWS ECR):
# REGISTRY=123456789012.dkr.ecr.ap-south-1.amazonaws.com

# ── Registry Authentication (production only) ────────────────
REGISTRY_USER=REPLACE_WITH_ECR_USER_OR_LEAVE_EMPTY
REGISTRY_PASSWORD=REPLACE_WITH_ECR_TOKEN_OR_USE_IRSA

# ── AWS Configuration (Terraform + ECR) ─────────────────────
AWS_ACCOUNT_ID=123456789012
AWS_REGION=ap-south-1

# ── Kubernetes Kubeconfigs (CI/CD secrets) ───────────────────
# Base64-encoded kubeconfig files. Set as GitHub Actions secrets.
# Generate: cat ~/.kube/config | base64 -w0
KUBECONFIG_DEV=BASE64_ENCODED_KUBECONFIG_FOR_DEV_CLUSTER
KUBECONFIG_PROD=BASE64_ENCODED_KUBECONFIG_FOR_PROD_CLUSTER

# ── Log Archival ─────────────────────────────────────────────
# S3 bucket for log archival. Leave empty to skip S3 upload.
SSB_LOG_S3_BUCKET=

# ── Application ──────────────────────────────────────────────
APP_ENV=dev
PORT=8080

# ── Argo CD ──────────────────────────────────────────────────
# Argo CD admin password (change after bootstrap).
ARGOCD_ADMIN_PASSWORD=REPLACE_AFTER_BOOTSTRAP

# ── Monitoring ───────────────────────────────────────────────
GRAFANA_ADMIN_PASSWORD=REPLACE_WITH_SECURE_PASSWORD

# ── GitHub Actions ───────────────────────────────────────────
# Set these as repository secrets in GitHub Settings → Secrets.
# GITHUB_TOKEN is auto-provided by Actions; do not set here.

# ── Secret Management (production) ───────────────────────────
# In production, secrets are fetched via External Secrets Operator
# from AWS Secrets Manager. These placeholders show the secret names.
# SECRETS_MANAGER_SECRET_ARN=arn:aws:secretsmanager:ap-south-1:123456789012:secret:ssb-digital-prod/ssb-app/api-key

# ── KMS ──────────────────────────────────────────────────────
# KMS key ARN for Terraform state and EKS secret encryption.
# DESIGN ONLY — used in terraform.tfvars.
KMS_KEY_ARN=arn:aws:kms:ap-south-1:123456789012:key/REPLACE_WITH_REAL_KEY_ID
